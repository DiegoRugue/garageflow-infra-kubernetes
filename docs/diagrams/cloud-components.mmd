---
config:
  theme: base
  themeVariables:
    fontFamily: Arial
    fontSize: 17px
    primaryColor: "#f1f5f9"
    primaryTextColor: "#172b4d"
    primaryBorderColor: "#94a3b8"
    lineColor: "#64748b"
    clusterBkg: "#ffffff"
    clusterBorder: "#94a3b8"
  flowchart:
    nodeSpacing: 48
    rankSpacing: 64
    curve: basis
---
flowchart TB
    Client@{ img: "data:image/svg+xml;base64,", label: "Cliente ou funcionário", pos: "b", w: 64, h: 64, constraint: "on" } -->|HTTPS| Gateway
    subgraph AWS["AWS Academy - us-east-1"]
        Gateway@{ img: "data:image/svg+xml;base64,", label: "API Gateway HTTP API", pos: "b", w: 64, h: 64, constraint: "on" }
        Authorizer@{ img: "data:image/svg+xml;base64,", label: "Lambda authorizer — repositório serverless", pos: "b", w: 64, h: 64, constraint: "on" }
        Gateway -->|JWT nas rotas protegidas| Authorizer
        subgraph VPC["VPC do ambiente"]
            subgraph Private["Subnets privadas de aplicação"]
                Auth@{ img: "data:image/svg+xml;base64,", label: "Lambda CPF — repositório serverless", pos: "b", w: 64, h: 64, constraint: "on" }
                Link@{ img: "data:image/svg+xml;base64,", label: "VPC Link", pos: "b", w: 64, h: 64, constraint: "on" }
                ALB@{ img: "data:image/svg+xml;base64,", label: "ALB interno — ingress", pos: "b", w: 64, h: 64, constraint: "on" }
                VPCE@{ img: "data:image/svg+xml;base64,", label: "Endpoint privado — Secrets Manager", pos: "b", w: 64, h: 64, constraint: "on" }
            end
            subgraph Workers["Subnets públicas dos workers"]
                EKS@{ img: "data:image/svg+xml;base64,", label: "Amazon EKS — dois nós", pos: "b", w: 64, h: 64, constraint: "on" }
                API[API e HPA — repositório aplicação]
                Collector[Coletor OTLP e métricas Kubernetes]
                EKS --- API
                EKS --- Collector
            end
            subgraph Database["Subnets dedicadas ao banco"]
                RDS@{ img: "data:image/svg+xml;base64,", label: "RDS PostgreSQL — repositório banco", pos: "b", w: 64, h: 64, constraint: "on" }
            end
            Link -->|HTTP 80| ALB
            Auth -->|HTTP 80 e JWT de serviço| ALB
            ALB -->|NodePort 30080| API
            API -->|PostgreSQL 5432| RDS
            API -->|OTLP privado 4318| Collector
            Auth --> VPCE
        end
        Secrets@{ img: "data:image/svg+xml;base64,", label: "AWS Secrets Manager", pos: "b", w: 64, h: 64, constraint: "on" }
        SNS@{ img: "data:image/svg+xml;base64,", label: "Amazon SNS — notificações", pos: "b", w: 64, h: 64, constraint: "on" }
        ECR@{ img: "data:image/svg+xml;base64,", label: "Amazon ECR — imagem por SHA", pos: "b", w: 64, h: 64, constraint: "on" }
        S3@{ img: "data:image/svg+xml;base64,", label: "Amazon S3 — estados e contratos", pos: "b", w: 64, h: 64, constraint: "on" }
        VPCE --> Secrets
        Authorizer --> Secrets
        API --> SNS
        ECR --> API
        Gateway -->|login CPF| Auth
        Gateway -->|integração privada| Link
    end
    Actions[GitHub Actions dos quatro projetos] -->|Terraform e contratos| S3
    Actions -->|deploy| EKS
    Collector -->|HTTPS 443| NR[New Relic: dashboards e alertas]

    style AWS fill:#fffaf2,stroke:#d97706,stroke-width:2px
    style VPC fill:#f8fafc,stroke:#7c3aed,stroke-width:2px
    style Private fill:#f0fdf4,stroke:#16a34a
    style Workers fill:#eff6ff,stroke:#2563eb
    style Database fill:#f0fdf4,stroke:#16a34a
